# ORION backend configuration.
#
# Credentials are read from the environment rather than frontend source, so
# nothing secret ends up in the client bundle. The server falls back to the
# demo values below when these are unset, so the demo runs with no setup.
#
# To override, either export these in your shell, or copy this file to `.env`
# and start the server with Node's own env-file loader:
#
#   node --env-file=.env dist/index.js       (after `npm run build`)
#
# These are DEMO credentials for a hackathon prototype. Do not reuse this
# pattern for anything with real access.

ORION_OPERATOR_ID=operator@orion.demo
ORION_OPERATOR_PASSWORD=ORION-OP-2026
ORION_OPERATOR_NAME=MUJ Operations — Operator

ORION_AUTHORITY_ID=authority@orion.demo
ORION_AUTHORITY_PASSWORD=ORION-AUTH-2026
ORION_AUTHORITY_NAME=National Space Authority — Reviewer

# Signs session tokens. A random secret is generated at startup when unset,
# which means restarting the server invalidates existing sessions.
# ORION_SESSION_SECRET=change-me

# PORT=4000
